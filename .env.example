# Copy to .env and supply credentials locally. Never commit .env.
# Generate SECRET_KEY and a URL-safe POSTGRES_PASSWORD before starting Docker.
SECRET_KEY=
POSTGRES_DB=podcasts
POSTGRES_USER=podcasts
POSTGRES_PASSWORD=
# Set to postgresql+psycopg2://podcasts:<password>@postgres:5432/podcasts
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1

# Supply environment credentials here, or use the normal SDK workload/metadata
# credential chain. The image and Compose do not mount host credential files.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=podcast-transcriptions-web-2025
YOUTUBE_API_KEY=

# Set false only for local development over HTTP.
SESSION_COOKIE_SECURE=true
MAX_CONTENT_LENGTH=1048576
MAX_AUDIO_BYTES=536870912
RSS_MAX_BYTES=10485760
YOUTUBE_CAPTION_MAX_BYTES=52428800
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=60
PODCAST_INITIAL_ITEM_LIMIT=25
YOUTUBE_INITIAL_ITEM_LIMIT=25
DISCOVERY_INTERVAL_SECONDS=3600
YOUTUBE_MAX_PAGES_PER_TASK=5
YOUTUBE_MAX_ITEMS_PER_BACKFILL_TASK=100
BACKFILL_REQUEST_MAX_ITEMS=5000
YOUTUBE_PREFERRED_CAPTION_LANGUAGES=en.*,en
YTDLP_EXPECTED_VERSION=2026.08.19
DENO_EXPECTED_VERSION=2.9.7
YTDLP_TIMEOUT_SECONDS=1800
TRANSCRIBE_POLL_SECONDS=10
TRANSCRIBE_TIMEOUT_SECONDS=14400
TRANSCRIBE_LANGUAGE_CODE=en-US
RATELIMIT_DEFAULT=
RATELIMIT_LOGIN=5 per minute
LOG_LEVEL=INFO

# Commercial classification and guest extraction call the Bezalel Platform Model
# Router as intelligence:podcast. Only the classifier mounts the client bundle,
# from ROUTER_CREDENTIALS_HOST_PATH (default ./.runtime/router; directory 700, files 600, UID 1000).
ROUTER_URL=https://192.168.68.200:18443
ROUTER_EXPECTED_MODEL=bonsai2:27b-pq2_0
CLASSIFIER_TIMEOUT_SECONDS=540
CLASSIFIER_MAX_REVISION_SECONDS=14400
CLASSIFIER_MAX_OUTPUT_BYTES=2097152
CLASSIFICATION_ENABLED=false
CLASSIFICATION_RECONCILE_INTERVAL_SECONDS=300
CLASSIFICATION_RECONCILE_BATCH_SIZE=100

# Router guest extraction (classifier container) and the nightly
# knowledge export (optional exporter service, COMPOSE_PROFILES=knowledge).
GUEST_EXTRACTION_ENABLED=false
GUEST_EXTRACTION_TIMEOUT_SECONDS=120
GUEST_EXTRACTION_MAX_CALLS_PER_DAY=200
GUEST_EXTRACTION_MAX_ITEMS_PER_RUN=25
GUEST_EXTRACTION_INTERVAL_SECONDS=3600
KNOWLEDGE_EXPORT_ENABLED=false
KNOWLEDGE_EXPORT_MAX_BATCHES_PER_RUN=5
KNOWLEDGE_EXPORT_MAX_RECORDS_PER_BATCH=10000
# Host path of the Platform podcast inbox and the numeric GID of intake-podcast.
PODCAST_INTAKE_INBOX_HOST_PATH=/srv/bezalel/intake/podcast/inbox
PODCAST_INTAKE_GID=
