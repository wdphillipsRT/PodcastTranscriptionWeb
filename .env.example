# Podcast Transcription Pipeline Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# API KEYS (Choose one or both providers)
# =============================================================================

# OpenAI Configuration (for summarization only, not transcription)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# AWS Configuration (for Amazon Transcribe and S3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-west-2

# OpenRouter Configuration  
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct:free

# =============================================================================
# TRANSCRIPTION SETTINGS
# =============================================================================

# Amazon Transcribe model - high accuracy cloud-based transcription
# Options: basic, enhanced
# basic: Standard accuracy, cost-effective
# enhanced: Higher accuracy, better punctuation and formatting
TRANSCRIBE_MODEL=basic

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Logging level
LOG_LEVEL=INFO

# Database path (relative to project root)
DB_PATH=data/meta.db

# Maximum concurrent downloads/processing
MAX_CONCURRENT=2

# =============================================================================
# MODEL RECOMMENDATIONS BY USE CASE
# =============================================================================

# For development/testing (fast, cheap):
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# TRANSCRIBE_MODEL=basic

# For production (high quality):
# OPENAI_MODEL=gpt-4o
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# TRANSCRIBE_MODEL=enhanced

# For cost-conscious production:
# OPENAI_MODEL=gpt-4o-mini  
# OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
# TRANSCRIBE_MODEL=basic